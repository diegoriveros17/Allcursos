DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_DIALECT=
PORT=3000
NODE_ENV=development
# En "npm run dev" el servidor abre el navegador solo. Poner en false para desactivarlo.
OPEN_BROWSER=true
JWT_SECRET=cambiar_este_valor_por_uno_seguro
JWT_EXPIRES_IN=7d

# Opcional: si no se completa, los emails se muestran por consola (modo simulado)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AllCursos <no-responder@allcursos.local>

# URL pública del frontend (usada en los links de los emails)
FRONTEND_URL=http://localhost:3000

# Chatbot: opcional. Si se completa, el chatbot usa un modelo real de Claude;
# si se deja vacío, funciona igual con un motor de reglas simple.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Verificación de DNI contra un padrón externo: opcional, no hay ninguna API
# gratuita conectada todavía (ver src/utils/dni.service.js)
DNI_API_URL=
DNI_API_KEY=