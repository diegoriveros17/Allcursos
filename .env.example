DB_NAME=allcursos_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_DIALECT=mysql
PORT=3000
JWT_SECRET=cambiar_este_valor_por_uno_seguro
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------
# RED / URL PÚBLICA  (para que enlaces y emails funcionen desde cualquier IP)
# ------------------------------------------------------------
# URL con la que los usuarios entran a la app. Se usa en los links de los emails,
# del QR de los certificados y de "compartir curso". Elegí UNA de estas opciones:
#   a) Dominio / IP pública completa (recomendado en producción):
#        APP_URL=https://allcursos.com.ar
#   b) Sólo la IP de esta máquina (usa PORT):  HOST_IP=192.168.1.35
#   c) No definir ninguna: se detecta la IP de red automáticamente (sólo desarrollo).
APP_URL=
HOST_IP=
# (Opcional) Interfaz donde escucha el servidor. Vacío = todas (localhost + IP de red).
HOST=
# Si hay un proxy/balanceador delante (Nginx, Render, Railway...): TRUST_PROXY=1
TRUST_PROXY=

# Seguridad & CORS: orígenes extra permitidos, separados por coma.
# Las peticiones del mismo origen (la propia app) siempre están permitidas.
CORS_ORIGIN=http://localhost:3000
# FRONTEND_URL quedó como alias viejo de APP_URL (se ignora si apunta a localhost)
FRONTEND_URL=

# Qué hace Sequelize al arrancar: force (borra y recrea TODAS las tablas), alter, safe
DB_SYNC=force

# Usuario Administrador inicial (se crea automáticamente si no existe ningún admin en la BD)
ADMIN_EMAIL=admin@allcursos.com
ADMIN_PASSWORD=Admin123!

# Almacenamiento en la nube (Cloudinary): Si se completa, las imágenes se suben a la nube.
# Si se deja vacío, se guardan en el disco local (/uploads/cursos).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# O alternativamente:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Opcional: si no se completa, los emails se muestran por consola (modo simulado)
SMTP_HOST=
SMTP_PORT=587
# true = TLS directo (puerto 465). Con 587 dejalo vacío (usa STARTTLS)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AllCursos <no-responder@allcursos.local>

# Chatbot con Gemini o modelos generativos
GEMINI_API_KEY=

# Verificación de DNI contra un padrón externo (opcional)
DNI_API_URL=
DNI_API_KEY=